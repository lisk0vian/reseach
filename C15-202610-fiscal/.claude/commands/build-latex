#!/bin/bash
# Build LaTeX manuscript for Journal of Big Data
# Usage: build-latex [main|main-simple]

cd "$(git rev-parse --show-toplevel)/papers/drafts/latex" 2>/dev/null || cd papers/drafts/latex

PLATFORM=$(uname -s)

if [ "$PLATFORM" = "Darwin" ] || [ "$PLATFORM" = "Linux" ] || grep -q Microsoft /proc/version 2>/dev/null; then
    # Unix-like: use Make
    if command -v make &> /dev/null; then
        make
    else
        # Fallback to bash script
        ./build-latex.sh "${1:-main-simple}"
    fi
else
    # Windows PowerShell
    if command -v powershell &> /dev/null; then
        powershell -NoProfile -ExecutionPolicy Bypass -Command ".\build-latex.ps1"
    else
        echo "Error: Neither Make nor PowerShell found"
        exit 1
    fi
fi
